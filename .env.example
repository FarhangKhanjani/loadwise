# Copy this file to .env and fill in real values. Never commit .env.

# SQLite file. Use data/loadwise.db for your real data, data/demo.db for sample data.
DB_PATH=data/loadwise.db

# Anthropic (Phase 3)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Default: Haiku 5.5 (cheapest, ~$0.001 per agent message). Alternatives: claude-sonnet-5-5, claude-opus-5-5
LLM_MODEL=claude-haiku-5-5

# Telegram (Phase 4)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Scheduling (Phase 5): the daily check runs at 08:00 in this time zone
TIMEZONE=Europe/Vienna

# HTTP API (Phase 5). Every endpoint except /health needs the header X-API-Key: <API_KEY>.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-api-key
# 127.0.0.1 = only this computer can reach the API
API_HOST=127.0.0.1
API_PORT=8000
