{
  "_about": "LoadWise agent eval. Each scenario: a dataset (fresh in-memory database), a fixed 'today', the user's message(s), and checks. Every scenario also gets the global checks: completed (no refusal or cut-off), numbers_grounded (no made-up numbers) and no_saved_claim. Check types are documented in evals/checks.py.",
  "scenarios": [
    {
      "id": "load_this_week",
      "category": "metrics",
      "dataset": "sample",
      "today": "2026-02-15",
      "messages": [
        "How is my training load this week?"
      ],
      "checks": {
        "tools_any": [
          [
            "get_load_summary",
            "get_active_flags"
          ]
        ],
        "numbers_required": [
          1.69
        ],
        "text_required": [
          "(?i)1\\.5"
        ]
      }
    },
    {
      "id": "overall_status",
      "category": "metrics",
      "why": "Phase 3: for a load question the agent only called get_load_summary and missed the sleep and soreness flags.",
      "dataset": "sample",
      "today": "2026-02-15",
      "messages": [
        "How am I doing overall?"
      ],
      "checks": {
        "numbers_required": [
          1.69
        ],
        "text_required": [
          "(?i)sleep",
          "(?i)sore"
        ]
      }
    },
    {
      "id": "acwr_needs_28_days",
      "category": "metrics",
      "dataset": "sample",
      "today": "2026-01-20",
      "messages": [
        "What's my ACWR right now?"
      ],
      "checks": {
        "tools_any": [
          [
            "get_load_summary",
            "get_active_flags"
          ]
        ],
        "text_required": [
          "(?i)28 days|four weeks|4 weeks"
        ],
        "text_forbidden": [
          "(?i)acwr\\s*(is|of|=|:|at)\\s*\\d"
        ]
      }
    },
    {
      "id": "stale_data",
      "category": "metrics",
      "why": "Missing logs look like rest: the last session was 15 days ago.",
      "dataset": "sample",
      "today": "2026-03-20",
      "messages": [
        "Am I undertraining at the moment?"
      ],
      "checks": {
        "tools_any": [
          [
            "get_load_summary",
            "get_active_flags",
            "get_sessions"
          ]
        ],
        "text_required": [
          "(?i)15 days|march 5|mar 5|5 march|2026-03-05|two weeks|2 weeks",
          "(?i)\\blog"
        ]
      }
    },
    {
      "id": "spike_after_logging_gap",
      "category": "metrics",
      "why": "The real history: one session after months without logs gives ACWR 4.0, only 1 of 4 weeks logged.",
      "dataset": "gap",
      "today": "2026-11-09",
      "messages": [
        "How is my training load? Any warning signs?"
      ],
      "checks": {
        "tools_any": [
          [
            "get_load_summary",
            "get_active_flags"
          ]
        ],
        "text_required": [
          "(?i)not (been )?logged|unlogged|missing|gap|only (1|one) of|haven'?t logged|weren'?t logged|no (sessions|training) (were |was )?logged|logging"
        ]
      }
    },
    {
      "id": "last_7_days_count",
      "category": "metrics",
      "dataset": "sample",
      "today": "2026-02-15",
      "messages": [
        "How many sessions did I do in the last 7 days, and what was the total load?"
      ],
      "checks": {
        "tools_any": [
          [
            "get_sessions",
            "get_load_summary"
          ]
        ],
        "numbers_required": [
          8,
          4253
        ]
      }
    },
    {
      "id": "log_padel_yesterday",
      "category": "logging",
      "why": "Phase 3: notes contained the agent's reasoning ('mapped to RPE 5').",
      "dataset": "sample",
      "today": "2026-02-15",
      "messages": [
        "I played padel yesterday for 75 minutes, it felt hard."
      ],
      "checks": {
        "proposal": {
          "action_type": "log_session",
          "fields": {
            "date": "2026-02-14",
            "sport_type": "padel",
            "duration_min": 75,
            "rpe": 5
          }
        },
        "notes_forbidden": "(?i)rpe|mapped|maps to|=|scale"
      }
    },
    {
      "id": "ask_when_duration_missing",
      "category": "logging",
      "dataset": "sample",
      "today": "2026-02-15",
      "messages": [
        "Played table tennis this evening, felt moderate."
      ],
      "checks": {
        "no_proposal": true,
        "text_required": [
          "(?i)how long|minutes|duration"
        ]
      }
    },
    {
      "id": "log_table_tennis_match",
      "category": "logging",
