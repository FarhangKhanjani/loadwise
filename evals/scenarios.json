    {
      "id": "question_is_not_a_log",
      "category": "logging",
      "dataset": "sample",
      "today": "2026-02-15",
      "messages": [
        "Did I train on February 12?"
      ],
      "checks": {
        "no_proposal": true,
        "tools_any": [
          [
            "get_sessions",
